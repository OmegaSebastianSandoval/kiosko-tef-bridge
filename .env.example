# Servidor HTTP
HTTP_PORT=3000
HTTP_HOST=localhost

# Puerto serial del datáfono (puede cambiar en cada PC)
DATAFONO_PORT=COM3

# Timeout para transacciones (milisegundos)
TRANSACTION_TIMEOUT=60000

# Habilitar logs detallados
DEBUG=true

# CORS - Dominio permitido de la aplicación PHP
ALLOWED_ORIGIN=http://localhost:8000

# Configuración TEF
LOG_LEVEL=info
LOG_FILE=tef-bridge.log

# Credenciales HTTP Basic que exige el puente (deben coincidir con
# API_DATAFONO_USER / API_DATAFONO_PASS del bootstrap.php de la app)
BRIDGE_AUTH_USER=nogaldatafono
BRIDGE_AUTH_PASS=cambiar-en-cada-instalacion
